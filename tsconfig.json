{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "outDir": "./dist",
    "rootDir": "./js",
    "sourceMap": true,
    "declaration": true,
    "removeComments": true,
    "noEmit": false,
    "allowJs": true,
    "checkJs": true
  },
  "include": ["js/**/*"],
  "exclude": ["node_modules", "dist"]
}